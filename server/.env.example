# Required
APP_TOKEN=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=

# Allowed browser origins, comma separated (where you serve app/index.html)
ALLOWED_ORIGINS=http://localhost:8080

# Optional research providers (at least one recommended)
BRAVE_API_KEY=
SERP_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional tuning
PORT=3000
RATE_LIMIT_PER_MIN=30
